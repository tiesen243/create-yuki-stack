{
  "name": "create-yuki-stack",
  "version": "0.3.2",
  "description": "A CLI tool for scaffolding type-safe, full-stack TypeScript applications with best practices and customizable.",
  "keywords": [
    "cli",
    "create-yuki-stack",
    "full-stack",
    "scaffolding",
    "turborepo",
    "workspace"
  ],
  "homepage": "https://create-yuki-stack.vercel.app",
  "license": "MIT",
  "author": {
    "name": "Tiesen",
    "url": "https://tiesen.id.vn"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tiesen243/create-yuki-stack",
    "directory": "cli"
  },
  "bin": {
    "create-yuki-stack": "./dist/index.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsdown --watch ./src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/cli": "^0.73.2",
    "@effect/platform": "^0.94.5",
    "@effect/platform-bun": "^0.87.1",
    "effect": "^3.19.19",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@yuki/tsconfig": "workspace:*",
    "tsdown": "^0.21.1",
    "typescript": "catalog:dev"
  }
}
